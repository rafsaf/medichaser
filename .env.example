MEDICOVER_USER=login
MEDICOVER_PASS=pass

LOG_LEVEL=INFO

# use apprise syntax as to send notifications of your choice: https://appriseit.com/services/
NOTIFIER_APPRISE_URLS=gotify://hostname/token
# you can also optionally add apprise config file to setup your services:
# NOTIFIER_APPRISE_CONFIG=/path/to/config

# examples:
# gotify
# NOTIFIER_APPRISE_URLS=gotify://hostname/token
# pushbullet
# NOTIFIER_APPRISE_URLS=pbul://accesstoken
# telegram
# NOTIFIER_APPRISE_URLS=tgram://bottoken/ChatID
# prowl
# NOTIFIER_APPRISE_URLS=prowl://apikey
# xmpp (jabber)
# NOTIFIER_APPRISE_URLS=xmpps://user:pass@hostname/jid
#
# adding several urls is possible - use semicolon between each url
# NOTIFIER_APPRISE_URLS=gotify://hostname/token;pbul://accesstoken;ntfy://topic/